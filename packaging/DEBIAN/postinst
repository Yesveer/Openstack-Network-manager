#!/bin/bash
set -e

case "$1" in
    configure)
        systemctl daemon-reload
        systemctl enable openstack-net-attach.service
        # Start the service but don't fail the install if it can't start right now.
        systemctl start openstack-net-attach.service || true
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
