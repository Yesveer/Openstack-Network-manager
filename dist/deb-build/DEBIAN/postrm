#!/bin/bash
set -e

case "$1" in
    remove)
        if systemctl is-enabled --quiet openstack-net-attach.service 2>/dev/null; then
            systemctl disable openstack-net-attach.service || true
        fi
        systemctl daemon-reload
        ;;
    purge)
        if systemctl is-enabled --quiet openstack-net-attach.service 2>/dev/null; then
            systemctl disable openstack-net-attach.service || true
        fi
        rm -rf /etc/openstack-net-attach
        rm -f /run/systemd/network/99-openstack-net-attach-*.network
        rm -f /etc/systemd/network/99-openstack-net-attach-*.network
        networkctl reload 2>/dev/null || true
        rm -f /run/openstack-net-attach-dhclient-*.pid
        systemctl daemon-reload
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
